# Emit bridges only for guest references that aren't provided by a host hook.
file(STRINGS "${OBJECT_LIST}" objects)
execute_process(COMMAND "${NM}" -P ${objects} OUTPUT_VARIABLE symbols COMMAND_ERROR_IS_FATAL ANY)
string(REGEX MATCHALL "(^|\n)(__imp__)?sub_[0-9A-F]+ [A-Za-z] " references "${symbols}")
foreach(reference IN LISTS references)
    string(REGEX REPLACE "^\n" "" reference "${reference}")
    string(REGEX REPLACE " .*$" "" name "${reference}")
    if(reference MATCHES " [Uw] $" OR (WINDOWS_GUEST AND reference MATCHES " W $"))
        list(APPEND imports "${name}")
    else()
        list(APPEND definitions "${name}")
    endif()
endforeach()
list(REMOVE_DUPLICATES imports)
if(definitions)
    list(REMOVE_ITEM imports ${definitions})
endif()
list(SORT imports)
if(WINDOWS_GUEST)
    list(REMOVE_DUPLICATES definitions)
    list(FILTER definitions INCLUDE REGEX "^sub_")
    list(SORT definitions)
    file(WRITE "${SUPPORT}/guest_hook_list.inc" "")
    file(WRITE "${SUPPORT}/guest_hook_defines.h" "")
    file(WRITE "${SUPPORT}/guest.def" "EXPORTS\n")
    foreach(name IN LISTS definitions)
        file(APPEND "${SUPPORT}/guest_hook_list.inc" "XBE_GUEST_HOOK(${name})\n")
        file(APPEND "${SUPPORT}/guest_hook_defines.h" "#define XBE_GUEST_HOOK_${name}\n")
    endforeach()
    foreach(name IN LISTS imports)
        file(APPEND "${SUPPORT}/guest.def" "    ${name}\n")
    endforeach()
    file(WRITE "${OUTPUT}" "#include \"app/portable_guest_abi.h\"\n#include \"core/log.h\"\n#include <windows.h>\n\n")
    foreach(name IN LISTS definitions)
        file(APPEND "${OUTPUT}" "X86_EXTERN_FUNC(${name});\n")
    endforeach()
    file(APPEND "${OUTPUT}" "\nconst PortableGuestServices& GuestHostServices() {\n    static X86Func* const hooks[] = {\n"
        "#define XBE_GUEST_HOOK(name) name,\n#include \"guest_hook_list.inc\"\n#undef XBE_GUEST_HOOK\n    };\n"
        "    static const PortableGuestServices services{x86_icall, x86_resume, x86_kernel, x86_trap,\n"
        "        x86_priv, x86_trace, x86_rdtsc, x86_cpuid, apu::SampleTime, hooks, sizeof(hooks) / sizeof(*hooks)};\n"
        "    return services;\n}\n")
    foreach(name IN LISTS imports)
        file(APPEND "${OUTPUT}" "static X86Func* ptr_${name};\n"
            "X86_FUNC(${name}) { ptr_${name}(ctx, base); }\n")
    endforeach()
    file(APPEND "${OUTPUT}" "\nbool BindGuestFunctions(void* module) {\n")
    foreach(name IN LISTS imports)
        file(APPEND "${OUTPUT}" "    ptr_${name} = reinterpret_cast<X86Func*>(GetProcAddress(static_cast<HMODULE>(module), \"${name}\"));\n"
            "    if (!ptr_${name}) { LOGE(\"Missing guest function ${name}\"); return false; }\n")
    endforeach()
    file(APPEND "${OUTPUT}" "    return true;\n}\n")
    return()
endif()
file(WRITE "${OUTPUT}" "#include \"cpu/x86_ops.h\"\n#include <dlfcn.h>\n#include <cstdio>\n\n")
foreach(name IN LISTS imports)
    file(APPEND "${OUTPUT}" "static X86Func* ptr_${name};\n"
         "__attribute__((visibility(\"hidden\"))) X86_FUNC(${name}) { ptr_${name}(ctx, base); }\n")
endforeach()
file(APPEND "${OUTPUT}" "\nbool BindGuestFunctions(void* module) {\n")
foreach(name IN LISTS imports)
    file(APPEND "${OUTPUT}" "    ptr_${name} = reinterpret_cast<X86Func*>(dlsym(module, \"${name}\"));\n"
         "    if (!ptr_${name}) { std::fprintf(stderr, \"Missing guest function ${name}\\n\"); return false; }\n")
endforeach()
file(APPEND "${OUTPUT}" "    return true;\n}\n")
